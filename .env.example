# ==========================================
# KONFIGURASI DATABASE (Pilih salah satu)
# ==========================================

# Opsi 1: Gunakan Supabase (Direkomendasikan untuk Cloud/CF Workers)
# Jika dua variabel ini diisi, aplikasi otomatis mengabaikan SQLite.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opsi 2: Gunakan SQLite Lokal (Untuk Docker/Self-Hosted)
# Biarkan SUPABASE_URL kosong, dan atur path database di sini.
SQLITE_DB_PATH=./data/smartinvoice.db

# ==========================================
# KONFIGURASI STORAGE (Upload Logo/QRIS)
# ==========================================
# Isi ini jika menggunakan Supabase Storage
SUPABASE_STORAGE_BUCKET=smartinvoice-assets