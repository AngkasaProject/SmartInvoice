# ==========================================
# KONFIGURASI DATABASE (PILIH SALAH SATU)
# ==========================================
# Jika Anda mengisi SUPABASE_URL, aplikasi otomatis menggunakan Supabase.
# Jika dikosongkan, aplikasi akan fallback ke SQLite lokal.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# (Opsional) Jika menggunakan SQLite lokal, atur lokasi file database
SQLITE_PATH=./data/smartinvoice.db


# ==========================================
# KONFIGURASI STORAGE (UPLOAD GAMBAR)
# ==========================================
# Nama bucket di Supabase Storage (wajib jika menggunakan Supabase)
SUPABASE_STORAGE_BUCKET=smartinvoice-assets


# ==========================================
# KONFIGURASI WHATSAPP GATEWAY
# ==========================================
# Jika WHATSAPP_PROVIDER diisi, form WhatsApp di UI akan TERKUNCI.
# Jika dikosongkan, form WhatsApp di UI bisa diubah dan disimpan ke database.

# Pilihan: "openwa" atau "fonnte"
WHATSAPP_PROVIDER=

# --- Konfigurasi OpenWA (Jika provider = openwa) ---
OPENWA_SERVER_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# --- Konfigurasi Fonnte (Jika provider = fonnte) ---
FONNTE_TOKEN=

# (Opsional) Template pesan pengantar default
WHATSAPP_CAPTION_TEMPLATE=


# ==========================================
# KONFIGURASI SERVER & APLIKASI
# ==========================================
# Port server backend (default: 3000)
PORT=3000

# Environment mode: "development" atau "production"
NODE_ENV=development

# URL Aplikasi (digunakan untuk webhook & redirect)
APP_URL=http://localhost:3000