# ==========================================
# DATABASE (Docker/Bun)
# ==========================================
# SQLite adalah database default/registry. Tanpa ENV provider, database aplikasi
# dapat dipilih dari Pengaturan dan kredensialnya disimpan di database default.
# Mengisi ENV provider atau DATABASE_DRIVER akan mengunci pilihan di Pengaturan.
# File .env ini tidak digunakan oleh Cloudflare Workers.
# Workers memakai binding DB/R2_BUCKET dari wrangler.toml dan secrets
# yang diatur dengan `npx wrangler secret put <NAMA_SECRET>`.
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opsional: Neon PostgreSQL via ENV (mengunci pilihan); atau atur dari UI.
NEON_DATABASE_URL=

# (Opsional) Pilih driver secara eksplisit: sqlite, supabase, atau neon.
DATABASE_DRIVER=

# Lokasi file SQLite lokal
SQLITE_PATH=./data/smartinvoice.db


# ==========================================
# KONFIGURASI STORAGE (UPLOAD GAMBAR)
# ==========================================
# Opsional: set hanya jika pengaturan bucket akan dikunci lewat environment.
# Tanpa nilai ini, nama bucket Supabase diatur dari panel (default: smartinvoice-assets).
SUPABASE_STORAGE_BUCKET=


# ==========================================
# KONFIGURASI WHATSAPP GATEWAY
# ==========================================
# Jika WHATSAPP_PROVIDER diisi, form WhatsApp di UI akan TERKUNCI.
# Jika dikosongkan, form WhatsApp di UI bisa diubah dan disimpan ke database.

# Pilihan: "openwa" atau "fonnte"
WHATSAPP_PROVIDER=

# --- Konfigurasi OpenWA (Jika provider = openwa) ---
OPENWA_SERVER_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# --- Konfigurasi Fonnte (Jika provider = fonnte) ---
FONNTE_TOKEN=

# (Opsional) Template pesan pengantar default
WHATSAPP_CAPTION_TEMPLATE=


# ==========================================
# KONFIGURASI SERVER & APLIKASI
# ==========================================
# Port server backend (default: 3000)
PORT=3000

# Environment mode: "development" atau "production"
NODE_ENV=development

# URL Aplikasi (digunakan untuk webhook & redirect)
APP_URL=http://localhost:3000